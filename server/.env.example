# Server port
PORT=5000

# MongoDB connection string (required)
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/chatapp?retryWrites=true&w=majority
# Local MongoDB example: mongodb://localhost:27017/chatapp
MONGODB_URI=

# Frontend URL for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173
